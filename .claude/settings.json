{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lockfile-guard.sh",
            "if": "Bash(dotnet *)",
            "timeout": 15,
            "statusMessage": "Lock-Dateien prüfen"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/chart-guard.sh",
            "timeout": 90,
            "statusMessage": "Chart rendern"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(kubeconform:*)",
      "Bash(./scripts/check-repro.sh)",
      "Bash(./scripts/check-digests.sh)"
    ]
  },
  "enableAllProjectMcpServers": false
}
