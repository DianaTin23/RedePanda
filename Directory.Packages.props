<Project>

    <!-- Central Package Management: every NuGet version lives here; .csproj carry
         <PackageReference Include="..." /> without a Version. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Ties the runtime base image to glibc: the native librdkafka assets load under
             neither musl (alpine) nor chiseled. See src/RedeTim.Backend/Dockerfile. -->
        <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

</Project>
