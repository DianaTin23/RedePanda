<Project>

    <!-- Central Package Management: every NuGet version for the repository lives here, and the
         .csproj files carry bare <PackageReference Include="..." /> entries without a version. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- No net10.0 asset ships in this package; it resolves lib/net8.0, which is supported.
             The container base image must stay glibc-based (see src/RedePanda.Backend/Dockerfile)
             or librdkafka fails to load at the first ConsumerBuilder.Build(). -->
        <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />

        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    </ItemGroup>

</Project>
