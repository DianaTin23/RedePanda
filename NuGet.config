<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <!-- Restore must not depend on whichever feeds happen to be configured on the machine.
         <clear /> drops everything inherited from ~/.nuget/NuGet/NuGet.Config and from the
         machine-wide store, so only the source named below is consulted. Without this the
         lock files still pin *which package versions* are used, but not where they come from:
         a local or corporate feed serving a different artifact under the same id and version
         would satisfy the lock. -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

</configuration>
