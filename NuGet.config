<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <!-- <clear /> verwirft die Feeds der Maschine, damit nur nuget.org befragt wird. Ohne das
         pinnen die Lockfiles zwar die Versionen, aber nicht deren Herkunft. -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

</configuration>
