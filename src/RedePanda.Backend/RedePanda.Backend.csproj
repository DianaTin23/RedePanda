<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>RedePanda.Backend</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Versions pinned in Directory.Packages.props, which also carries the note on why
             Confluent.Kafka constrains the container base image (see Dockerfile). -->
        <PackageReference Include="Confluent.Kafka" />

        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../RedePanda.Contracts/RedePanda.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RedePanda.Backend.Tests" />
    </ItemGroup>

</Project>
