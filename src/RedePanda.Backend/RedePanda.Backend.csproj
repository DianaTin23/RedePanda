<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>RedePanda.Backend</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!-- No net9.0 asset ships in this package; it resolves lib/net8.0, which is supported.
             The container base image must stay glibc-based (see Dockerfile) or librdkafka
             fails to load at the first ConsumerBuilder.Build(). -->
        <PackageReference Include="Confluent.Kafka" Version="2.15.0" />

        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../RedePanda.Contracts/RedePanda.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RedePanda.Backend.Tests" />
    </ItemGroup>

</Project>
